{
	admin off
	# The private CA below lives inside the container; there is no host trust
	# store to install its root into.
	skip_install_trust
	# Safari sends no SNI when connecting to an IP address.
	default_sni {$LAN_HTTPS_HOST:localhost}
	# Production: the tunnel connector forwards the visitor's scheme and address.
	servers :8080 {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
		# Read X-Forwarded-For from the right, skipping trusted proxies, so a
		# visitor cannot choose the address the sign-up limits see.
		trusted_proxies_strict
	}
	# A browser that sends plain HTTP to the HTTPS port is redirected to
	# HTTPS rather than shown an error.
	servers :8443 {
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

# Lets the one configured dev origin (the Expo dev server) call the stack.
# The built app is same-origin and never sends these requests.
(dev_cors) {
	@preflight {
		method OPTIONS
		header Origin {$CORS_DEV_ORIGIN:http://cors-disabled.invalid}
	}
	@from_dev header Origin {$CORS_DEV_ORIGIN:http://cors-disabled.invalid}

	handle @preflight {
		header Access-Control-Allow-Origin {$CORS_DEV_ORIGIN:http://cors-disabled.invalid}
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers {http.request.header.Access-Control-Request-Headers}
		header Access-Control-Max-Age 600
		header Vary Origin
		respond 204
	}
	# defer: set after the upstream answers, replacing any value it sent.
	header @from_dev {
		defer
		Access-Control-Allow-Origin {$CORS_DEV_ORIGIN:http://cors-disabled.invalid}
		Vary Origin
	}
}

(app) {
	encode zstd gzip

	# Security headers on every response (issue #64). The session lives in
	# localStorage, so the policy keeps any script but our own from running.
	# - script-src: our bundles, PowerSync's SQLite WASM, and the one inline
	#   script in apps/mobile/public/index.html by its hash. Editing that script
	#   changes the hash; src/theme/csp.test.ts says what to put here.
	# - style-src 'unsafe-inline': react-native-web writes its styles inline.
	# - img-src blob: data:: photos are shown from local storage.
	# - worker-src blob:: what the PowerSync and Workbox workers may spawn.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-25JebiLIP2H8T0uCnNh/i9YjgtHC8p6Xy3/7rsyaDNs='; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}
	# HSTS only over the tunnel: Cloudflare serves HTTPS and says so. Plain
	# http://localhost must not get it, since HSTS covers a host on every port.
	@edge_https header X-Forwarded-Proto https
	header @edge_https Strict-Transport-Security "max-age=31536000"

	# route keeps these in the order written.
	route {
		import dev_cors

		handle /healthz {
			respond "ok" 200
		}
		# The public root of the private CA, so a phone can install and trust
		# it. Only this one file under /data is reachable.
		handle /local-ca.crt {
			root * /data/caddy/pki/authorities/local
			rewrite * /root.crt
			header Content-Type application/x-x509-ca-cert
			file_server
		}
		# Only the GoTrue routes the app uses (issue #68): email codes, token
		# refresh, sign-out, the key set and health. Everything else, the
		# admin API, password sign-up and login, setting a password, is 404.
		handle_path /auth/* {
			@auth_allowed expression <<CEL
				(method('POST') && path('/otp', '/verify', '/logout'))
				|| (method('POST') && path('/token') && {http.request.uri.query} == 'grant_type=refresh_token')
				|| (method('GET') && path('/user', '/.well-known/jwks.json', '/health'))
				CEL
			handle @auth_allowed {
				reverse_proxy auth:9999 {
					# GoTrue's per-address limits key on this header and are off
					# without it. Set here, so a client-sent value is overwritten.
					header_up X-Client-IP {client_ip}
				}
			}
			respond 404
		}
		handle /api/* {
			# A coarse cap; the API enforces its exact 1 MB limit itself.
			request_body {
				max_size 4MB
			}
			reverse_proxy api:3000 {
				# The visitor's address for the API's sign-up limits.
				header_up X-Client-IP {client_ip}
			}
		}
		# Only the sync stream (HTTP or WebSocket) and write checkpoints
		# (issue #68); PowerSync's admin and other routes are 404.
		handle_path /sync/* {
			@sync_allowed path /sync/stream /write-checkpoint2.json
			handle @sync_allowed {
				reverse_proxy sync:8080 {
					flush_interval -1
				}
			}
			respond 404
		}
		handle /email-templates/* {
			root * /srv
			file_server
		}
		# iOS also asks for its home-screen icon at these root paths; without
		# this they would get the app's HTML.
		@touch_icon path /apple-touch-icon.png /apple-touch-icon-precomposed.png
		handle @touch_icon {
			root * /srv/web
			rewrite * /icons/apple-touch-icon.png
			file_server
		}
		# Content-hashed bundle names: safe to cache for good.
		handle /_expo/static/* {
			root * /srv/web
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		# Everything else of the web app, including sw.js and index.html under
		# any app path, is revalidated on each load. Headers are set before the
		# index.html fallback rewrite, so app paths cannot be matched by name.
		handle {
			root * /srv/web
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}

# Plain HTTP: containers, tests, and browsers on this machine.
{$SITE_ADDRESS::8080} {
	import app
}

# HTTPS for phones on the LAN or VPN, signed by Caddy's private CA. Browsers
# need a secure origin for the app's storage and workers.
https://{$LAN_HTTPS_HOST:localhost}:8443 {
	tls internal
	import app
}
