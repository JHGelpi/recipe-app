{
  "name": "recipe-app",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present run typecheck",
    "dev:web": "pnpm --filter mobile run web",
    "test:e2e": "playwright test",
    "dev:backend": "supabase start -x studio,imgproxy,logflare,vector,supavisor,realtime,storage-api,postgres-meta && node scripts/write-env.mjs",
    "dev:backend:full": "supabase start && node scripts/write-env.mjs",
    "dev:backend:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:rls": "vitest run -c vitest.integration.config.ts supabase/tests/rls",
    "test:functions": "vitest run -c vitest.integration.config.ts supabase/tests/functions"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@supabase/supabase-js": "^2.117.3",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "supabase": "^2.120.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
