# Production (docs/RUNBOOK.md). `pnpm prod:init` writes .env.production from
# this file, generating every secret and asking for the rest. Only the
# `pnpm prod:*` commands read it; the guard keeps dev and test commands away.
APP_ENV=production
COMPOSE_PROJECT_NAME=dishkept

# --- Where the stack is reached ---
# Cloudflare Tunnel serves this address; the tunnel points at http://proxy:8080.
PUBLIC_URL=https://dishkept.geltech.dev
SITE_ADDRESS=:8080
# The token of the remotely managed tunnel (Cloudflare Zero Trust > Tunnels).
TUNNEL_TOKEN=

# --- Database passwords (hex only: they are placed inside connection URLs) ---
POSTGRES_PASSWORD=
APP_OWNER_PASSWORD=
API_LOGIN_PASSWORD=
AUTH_DB_PASSWORD=
POWERSYNC_REPL_PASSWORD=
POWERSYNC_STORAGE_PASSWORD=

# --- Token signing ---
JWT_SECRET=
JWT_KEYS=

# --- Email (Zoho: the login and the From address must match) ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SENDER_NAME=Dishkept
AUTH_EMAIL_MAX_FREQUENCY=60s
AUTH_RATE_LIMIT=10
# Added to the allowed list at the first deploy, when the gate is turned on.
OWNER_EMAIL=

# --- Backups (production spec §5) ---
BACKUP_BUCKET=
# The age public key (age1...). The private key stays in your password manager.
BACKUP_AGE_RECIPIENT=
BACKUP_ALERT_TO=
BACKUP_TIME=03:30
TZ=America/New_York
GCS_KEY_FILE=./.local/gcs-backup-key.json

# --- AI (server-only) ---
ANTHROPIC_API_KEY=
LLM_MODEL_PARSE=
LLM_MODEL_SUBSTITUTE=
LLM_PRICE_INPUT_PER_MTOK_USD=2
LLM_PRICE_OUTPUT_PER_MTOK_USD=10
AI_MONTHLY_CAP_USD=2
