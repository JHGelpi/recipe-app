# Run `pnpm env:init` to create .env from this file. It fills every empty
# secret below with a generated value. Nothing here is bundled into the web app.

# --- Where the stack is reached ---
# The address browsers and tests on this machine use. Its port must match
# PROXY_PORT; change both if another program already uses 8080.
PUBLIC_URL=http://localhost:8080
# Caddy site address. ":8080" serves plain HTTP; a domain name turns on HTTPS.
SITE_ADDRESS=:8080
PROXY_PORT=8080
# The address phones use to reach this machine over the LAN or VPN (an IP or
# a hostname). The proxy serves https://<LAN_HTTPS_HOST>:<LAN_HTTPS_PORT> with a
# certificate from its own private CA; see README "Testing on a phone".
LAN_HTTPS_HOST=localhost
LAN_HTTPS_PORT=8443
# The one other origin allowed to call the stack: the Expo dev server.
CORS_DEV_ORIGIN=http://localhost:8081

# --- Database passwords (hex only: they are placed inside connection URLs) ---
POSTGRES_PASSWORD=
APP_OWNER_PASSWORD=
API_LOGIN_PASSWORD=
AUTH_DB_PASSWORD=
POWERSYNC_REPL_PASSWORD=
POWERSYNC_STORAGE_PASSWORD=

# --- Token signing ---
# JWT_KEYS is a JSON array holding one private ES256 key. GoTrue signs with it
# and publishes the public half; the API and sync service verify against that.
JWT_SECRET=
JWT_KEYS=

# --- Email ---
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@recipes.localhost
# Loose limits for local development and tests. Tighten for production.
AUTH_EMAIL_MAX_FREQUENCY=1s
AUTH_RATE_LIMIT=1000

# --- Local development and tests only ---
DB_HOST_PORT=54329
MAIL_HOST_PORT=8025

# --- AI (server-only; first used in sub-project 4) ---
ANTHROPIC_API_KEY=
LLM_MODEL_PARSE=
LLM_MODEL_SUBSTITUTE=
# Prices per million tokens, in dollars, for LLM_MODEL_PARSE (see anthropic.com/pricing).
LLM_PRICE_INPUT_PER_MTOK_USD=3
LLM_PRICE_OUTPUT_PER_MTOK_USD=15
# NFR-7: per-household monthly AI spend cap, in dollars.
AI_MONTHLY_CAP_USD=2
# Test-only overrides live in docker-compose.test.yml (ANTHROPIC_BASE_URL,
# IMPORT_FETCH_ALLOW_HOSTS). Do not set them here.
